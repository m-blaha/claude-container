#!/bin/bash

if [[ "$PWD" != "$HOME/src"* ]]; then
    echo "Error: must be run from within ~/src/" >&2
    exit 1
fi

# Scope mount to the current project, not all of ~/src.
# For git worktrees, mount the parent that contains all worktrees + the main
# repo's .git dir (worktrees reference it via relative gitdir pointers).
# When PWD is ~/src itself, there's no project to mount (~/src is already
# mounted read-only below).
PROJECT_SUBDIR="$(echo "${PWD#$HOME/src/}" | cut -d/ -f1)"
if [[ -n "$PROJECT_SUBDIR" && "$PROJECT_SUBDIR" != "$PWD" ]]; then
    PROJECT_ROOT="$HOME/src/$PROJECT_SUBDIR"
else
    PROJECT_ROOT=""
fi

# Check for updates weekly, or build if image missing
STAMP="$HOME/.claude-container/.last-build"
IMAGE_EXISTS=$(podman image exists claude-code 2>/dev/null && echo 1 || echo 0)
if [[ "$IMAGE_EXISTS" == "0" ]] || [[ ! -f "$STAMP" ]] || [[ $(( $(date +%s) - $(stat -c %Y "$STAMP") )) -gt 604800 ]]; then
    CURRENT=$(podman run --rm --entrypoint claude claude-code --version 2>/dev/null | head -1 | awk '{print $1}')
    LATEST=$(podman run --rm --entrypoint npm claude-code view @anthropic-ai/claude-code version 2>/dev/null)

    if [[ -z "$CURRENT" ]]; then
        echo "Claude Code container image not found, building..."
        REBUILD=1
    fi

    if [[ -z "$LATEST" && "$REBUILD" == "1" ]]; then
        # No image to check npm from, build with default version
        true
    elif [[ -n "$LATEST" && -n "$CURRENT" && "$CURRENT" != "$LATEST" ]]; then
        echo "Claude Code update available: $CURRENT -> $LATEST"
        read -p "Update? [Y/n] " -n 1 -r
        echo
        [[ ! $REPLY =~ ^[Nn]$ ]] && REBUILD=1
    fi

    if [[ "$REBUILD" == "1" ]]; then
        VERSION="${LATEST:-2.1.83}"
        if podman build --pull --no-cache \
            --build-arg "CLAUDE_VERSION=$VERSION" \
            -t claude-code "$HOME/src/claude-container/"; then
            touch "$STAMP"
        else
            echo "Warning: rebuild failed, using existing image" >&2
        fi
    else
        touch "$STAMP"
    fi
fi

# --- Dev container (auto-detected for dnf5 worktrees) ---
DEV_CONTAINER=""
DEV_ARGS=()

if [[ "$PWD" == "$HOME/src/dnf5/"* ]]; then
    WORKTREE=$(echo "$PWD" | sed "s|$HOME/src/dnf5/||" | cut -d/ -f1)
    DNF5_SRC="$HOME/src/dnf5/$WORKTREE"

    # Build dev image if needed (weekly rebuild)
    DEV_STAMP="$HOME/.claude-container/.last-dev-build"
    DEV_IMAGE_EXISTS=$(podman image exists dnf5-dev 2>/dev/null && echo 1 || echo 0)
    if [[ "$DEV_IMAGE_EXISTS" == "0" ]] || [[ ! -f "$DEV_STAMP" ]] || [[ $(( $(date +%s) - $(stat -c %Y "$DEV_STAMP") )) -gt 604800 ]]; then
        echo "Building dnf5 dev container image..."
        if podman build --pull \
            -f "$HOME/src/claude-container/Containerfile.dnf5-dev" \
            -t dnf5-dev "$HOME/src/claude-container/"; then
            touch "$DEV_STAMP"
        else
            echo "Warning: dev container build failed, proceeding without build support" >&2
        fi
    fi

    # Clean up stale dev containers from crashed sessions (PID no longer running)
    for stale in $(podman ps -a --filter "name=dnf5-dev-" --format "{{.Names}}" 2>/dev/null); do
        stale_pid="${stale##dnf5-dev-}"
        if ! kill -0 "$stale_pid" 2>/dev/null; then
            echo "Cleaning up stale dev container: $stale"
            podman rm -f "$stale" 2>/dev/null || true
        fi
    done

    if podman image exists dnf5-dev 2>/dev/null; then
        DEV_CONTAINER="dnf5-dev-$$"
        echo "Starting dev container: $DEV_CONTAINER (source: $DNF5_SRC)"
        podman run -d --rm \
            --name "$DEV_CONTAINER" \
            --security-opt label=disable \
            -e "CCACHE_BASEDIR=$DNF5_SRC" \
            -e "CCACHE_DIR=/root/.cache/ccache" \
            -v "$PROJECT_ROOT:$PROJECT_ROOT" \
            -v "$HOME/.cache/ccache:/root/.cache/ccache" \
            dnf5-dev >/dev/null

        PODMAN_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"

        DEV_ARGS=(
            -e "DNF5_DEV_CONTAINER=$DEV_CONTAINER"
            -e "DNF5_SRC_DIR=$DNF5_SRC"
            -v "$PODMAN_SOCK:/run/podman.sock"
            -v "$HOME/src/claude-container/dev-scripts:/usr/local/bin/dev:ro"
            -e "PATH=/usr/local/bin/dev:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        )
    fi
fi

cleanup() {
    if [[ -n "$DEV_CONTAINER" ]]; then
        podman stop "$DEV_CONTAINER" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

# GitHub fine-grained token required for gh,
# "Public repositories (read-only)", no extra permissions
# GIT_CONFIG_* rewrites git SSH URLs to HTTPS (no SSH keys in container)
podman run -it --rm \
    --security-opt label=disable \
    --sysctl net.ipv6.conf.all.disable_ipv6=1 \
    -e CLAUDE_CODE_USE_VERTEX="${CLAUDE_CODE_USE_VERTEX:-1}" \
    -e ANTHROPIC_VERTEX_PROJECT_ID="${ANTHROPIC_VERTEX_PROJECT_ID:?Set ANTHROPIC_VERTEX_PROJECT_ID}" \
    -e CLOUD_ML_REGION="${CLOUD_ML_REGION:?Set CLOUD_ML_REGION}" \
    -e TERM="$TERM" \
    -e GH_TOKEN="$(cat "$HOME/.claude-container/.gh-token" 2>/dev/null)" \
    -e GIT_CONFIG_COUNT=1 \
    -e ANTHROPIC_MODEL="$ANTHROPIC_MODEL" \
    -e "GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf" \
    -e "GIT_CONFIG_VALUE_0=git@github.com:" \
    -v "$HOME/.config/gcloud/application_default_credentials.json:/root/.config/gcloud/application_default_credentials.json:ro" \
    ${PROJECT_ROOT:+-v "$PROJECT_ROOT:$PROJECT_ROOT"} \
    -v "$HOME/src:$HOME/src:ro" \
    -v "$HOME/.claude-container:/root/.claude" \
    -v "$HOME/src/claude-container/commands:/root/.claude/commands:ro" \
    -v "$HOME/.claude-container/.claude.json:/root/.claude.json" \
    -v "$HOME/.gitconfig:/root/.gitconfig:ro" \
    "${DEV_ARGS[@]}" \
    -w "$PWD" \
    claude-code "$@"
